# ================================================================
# 使用方法: cp .env.example .env  然后填写真实值
# ================================================================

# 运行环境
# 控制加载 config/dev.yaml 还是 config/prod.yaml
# 可选值: dev | test | prod
TEST_ENV=dev

# 被测应用账号
# 演示站点 https://www.saucedemo.com 的默认账号
TEST_USER=standard_user
TEST_PASSWORD=secret_sauce

# 数据库
# SQLite（默认，无需安装）
# DB_URL=sqlite+aiosqlite:///./data/test_results.db
# MySQL 示例（可选替换）
DB_URL=mysql+aiomysql://user:password@localhost:3306/testdb

# AI功能（可选）
# 不填则所有 AI 功能自动跳过，不影响测试执行
OPENAI_API_KEY=
# 国内代理或 Azure OpenAI 时替换此地址
OPENAI_BASE_URL=https://api.openai.com/v1

# 企业微信群机器人
# 在企业微信群 → 群设置 → 群机器人 → 添加 → 复制 Webhook 地址
WECHAT_WEBHOOK=

# Jenkins（可选）
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=

# 邮件通知（可选）
TEAM_EMAIL=team@example.com

# 浏览器环境变量覆盖（可选）
# 优先级高于 config/dev.yaml，留空则使用 yaml 配置
# BROWSER_TYPE=chromium
# BROWSER_HEADLESS=false
# BROWSER_SLOW_MO=0
# ================================================================
# 环境变量配置模板
# 使用: cp .env.example .env  然后填写真实值
# ================================================================

# 运行环境
TEST_ENV=dev

# 被测应用账号（SauceDemo 演示站点）
TEST_USER=standard_user
TEST_PASSWORD=secret_sauce

# 数据库
# SQLite（默认，无需安装数据库）
# DB_URL=sqlite+aiosqlite:///./data/test_results.db
#
# MySQL（需安装 aiomysql：pip install aiomysql）
DB_URL=mysql+aiomysql://用户名:密码@localhost:3306/testdb

# AI功能（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 邮件通知 SMTP 配置
#
# 收件人（多个用英文逗号分隔）
ALERT_EMAIL=your@email.com,teammate@email.com
#
# QQ 邮箱配置（推荐）
# 1. 登录 QQ 邮箱网页版 → 设置 → 账户
# 2. 开启 IMAP/SMTP 服务
# 3. 生成并复制授权码（不是 QQ 密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq@qq.com
SMTP_PASSWORD=your_qq_auth_code_here
SMTP_USE_SSL=true
SMTP_SENDER_NAME=自动化测试平台
#
# 163 邮箱配置
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=your_163@163.com
# SMTP_PASSWORD=your_163_auth_code_here
# SMTP_USE_SSL=true
#
# Gmail 配置
# 需开启两步验证并生成应用专用密码
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_app_password_here
# SMTP_USE_SSL=false
#
# 企业邮箱（腾讯/阿里）
# SMTP_HOST=smtp.exmail.qq.com
# SMTP_PORT=465
# SMTP_USER=your@company.com
# SMTP_PASSWORD=your_email_password
# SMTP_USE_SSL=true

# 平台访问地址（邮件中的跳转链接）
PLATFORM_URL=http://localhost:5173
ALLURE_URL=http://localhost:5050

# Jenkins（可选）
JENKINS_URL=http://localhost:8080
JENKINS_USER=admin
JENKINS_TOKEN=